# ==============================================================================
# NEO Employee Management System (EMS) — Environment Variables Reference
# ==============================================================================
# COMPLETE inventory: every variable the code reads (grep-verified 2026-10-05
# across apps/api/src, apps/worker/src, apps/web/src, packages/*/src, scripts/;
# enforced by scripts/check-env-docs.sh in CI).
# Sections marked REQUIRED fail closed at boot when unset in production.
# Values below are LOCAL-DEV placeholders — never use them in production.
# Generate real secrets with:  openssl rand -base64 48
#
# Name-unification log (one name everywhere — code + this file + k8s/):
#   SMTP_PASSWORD   (was SMTP_PASS in code; docs/k8s already used SMTP_PASSWORD)
#   MFA_TOTP_WINDOW (was MFA_WINDOW here; code reads MFA_TOTP_WINDOW)
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI,
#   MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET / MICROSOFT_REDIRECT_URI,
#   MICROSOFT_TENANT, OAUTH_ENABLED
#     (replaces OAUTH_GOOGLE_CLIENT_ID / OAUTH_GOOGLE_CLIENT_SECRET /
#      OAUTH_MICROSOFT_CLIENT_ID / OAUTH_MICROSOFT_CLIENT_SECRET, which the
#      code never read — OAuth now uses the provider-native names)
#   AI_CIRCUIT_RECOVERY_WINDOW_MS (was AI_CIRCUIT_RECOVERY_MS in the worker)
# Removed: JWT_REFRESH_SECRET (no longer read by code — opaque refresh tokens).
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime (all services read these)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME="NEO EMS"
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
# Extra CORS origins beyond FRONTEND_URL (comma-separated, no spaces).
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# PostgreSQL — REQUIRED in production (managed DB: RDS / Cloud SQL / …).
# The API and worker fail closed when DATABASE_URL is unset. There is no
# embedded database and no boot-time migration/seed in production images.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://ems_admin:ems_secure_password_123!@localhost:5432/ems_db?schema=public
# Dev-compose only (docker-compose.yml):
POSTGRES_USER=ems_admin
POSTGRES_PASSWORD=ems_secure_password_123!
POSTGRES_DB=ems_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis & BullMQ — REQUIRED host/port in production (REDIS_PASSWORD strongly
# recommended; prod compose refuses to start without it).
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL is read as an alternative connection string by some paths.
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3-compatible) — S3_ACCESS_KEY / S3_SECRET_KEY are
# REQUIRED in production (fail closed; never defaulted in code).
# Buckets are PRIVATE: no anonymous bucket policy anywhere.
# ------------------------------------------------------------------------------
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password_123!
S3_BUCKET=ems-documents
S3_USE_SSL=false
S3_REGION=us-east-1
# Avatars (go-live Phase 3 item 8): base64 avatars moved to object storage.
# Separate bucket so avatar lifecycle/CORS can differ from documents.
AVATAR_S3_BUCKET=ems-avatars
# Max avatar upload size in bytes (server-enforced; 5 MB default).
AVATAR_MAX_BYTES=5242880
# Presigned-URL expiry for avatar GETs, in seconds (1h default).
AVATAR_PRESIGNED_URL_EXPIRY_SECONDS=3600
# Malware scanning (go-live): interface is fail-closed when enabled; default
# is a no-op hook (accepted risk — see docs/DEPLOYMENT.md). Set true with a
# real scanner before untrusted uploads in production.
DOCUMENT_MALWARE_SCAN_ENABLED=false
# Dev-compose only (docker-compose.yml):
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_123!

# ------------------------------------------------------------------------------
# Authentication & tokens — JWT_ACCESS_SECRET REQUIRED in production.
# JWT_REFRESH_SECRET was removed: refresh tokens are opaque random tokens
# stored hashed server-side (see apps/api/src/config/configuration.ts).
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_VALUE__openssl_rand_-base64_48
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Rate limiting (throttler; Redis-backed counters per B8).
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# Security switches & identity plumbing
# ------------------------------------------------------------------------------
# false (default) = invitation-only onboarding: POST /auth/register 403s and
# the web /register page is hidden. Set true only to open self-registration.
ALLOW_PUBLIC_REGISTRATION=false
# Reverse-proxy hops trusted for Express 'trust proxy' (client-IP for
# throttler keys behind a load balancer). Default 1.
TRUST_PROXY_HOPS=1
# Name of the non-httpOnly double-submit CSRF cookie.
CSRF_COOKIE_NAME=csrf
# Invitation token lifetime (hours).
INVITATION_TTL_HOURS=72
# Password-reset token lifetime (minutes).
PASSWORD_RESET_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# Documents — DOCUMENT_ENCRYPTION_KEY REQUIRED in production.
# 32-byte hex-encoded key for AES-256-GCM (NOT base64):
#   openssl rand -hex 32
# Rotation procedure: docs/KEY_ROTATION.md
# ------------------------------------------------------------------------------
DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS__openssl_rand_-hex_32
DOCUMENT_ENCRYPTION_ENABLED=true
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg
DOCUMENT_PRESIGNED_URL_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# Payroll / currency
# ------------------------------------------------------------------------------
# ISO 4217 code. Precision (minor units) comes from
# packages/shared/src/payroll/currency.ts — extend the map for new currencies.
PAYROLL_CURRENCY=GBP
# Display default used by shared CurrencyUtil (falls back to GBP).
DEFAULT_CURRENCY=GBP

# ------------------------------------------------------------------------------
# AI providers — keys REQUIRED only when AI features are enabled.
# Legacy GEMINI_API_KEY / GROQ_API_KEY are honoured as fallbacks; prefer AI_*.
# Model allowlist: only the models below (or their env overrides) may be used.
# ------------------------------------------------------------------------------
AI_GEMINI_API_KEY=
AI_GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PRIMARY_PROVIDER=gemini
AI_SECONDARY_PROVIDER=groq
AI_GEMINI_MODEL=gemini-2.5-flash
AI_GROQ_MODEL=llama-3.3-70b-versatile
# Extra models the assistant may call, comma-separated. The two configured
# provider models are always allowed even when this is empty.
AI_MODEL_ALLOWLIST=
# Max billable AI requests per user per day (fail-closed counter).
AI_DAILY_BUDGET_PER_USER=100
AI_TIMEOUT_MS=30000
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RECOVERY_WINDOW_MS=30000
AI_CIRCUIT_HALF_OPEN_LIMIT=2
# Retention (days) for AI audit logs; the maintenance worker purges older rows.
AI_LOG_RETENTION_DAYS=90
# When true, the purge job counts but does not delete (dry run).
AI_PURGE_DRY_RUN=false

# ------------------------------------------------------------------------------
# Audit log
# ------------------------------------------------------------------------------
# Days of audit events retained before the maintenance purge deletes them.
# The default below is a PLACEHOLDER — counsel must sign off the real
# schedule (Phase 2 retention schedule); the purge job runs dry-run until
# sign-off is recorded in config.
AUDIT_RETENTION_DAYS=365
# Extra JSON keys masked in audit payloads, comma-separated
# (in addition to the built-in password/token/secret patterns).
AUDIT_PII_MASK_KEYS=

# ------------------------------------------------------------------------------
# Worker — scheduling
# ------------------------------------------------------------------------------
# IANA timezone for BullMQ cron schedules (leave accrual, sweeps, purges).
SCHEDULE_TZ=UTC
# Stuck payroll-run sweep (go-live Phase 2 item 1): cron + staleness threshold.
# PROCESSING runs older than the threshold are reset to DRAFT and requeued.
PAYROLL_SWEEP_CRON=*/15 * * * *
PAYROLL_SWEEP_STALE_MINUTES=30
# Monthly leave-accrual cron (go-live Phase 3 item 1): credits
# LeavePolicy.accrualPerMonth into employee balances, idempotent per month.
LEAVE_ACCRUAL_CRON=0 1 1 * *

# ------------------------------------------------------------------------------
# GDPR retention schedule (go-live Phase 2 item 3)
# ------------------------------------------------------------------------------
# Per-entity windows live in apps/api/src/modules/gdpr/retention-schedule.ts
# (commented as counsel-sign-off placeholders). The purge job is FORCED
# dry-run until BOTH this flag is true AND the purge endpoint is called with
# { dryRun: false } explicitly.
GDPR_RETENTION_SIGNED_OFF=false

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
# Reserved: guarded /metrics scrape port (Phase 1 observability wiring).
METRICS_PORT=9090

# ------------------------------------------------------------------------------
# Web frontend (build-time NEXT_PUBLIC_* are baked into the web image)
# ------------------------------------------------------------------------------
# NOTE: apps/web/.env.example is the web-specific companion (copy to
# apps/web/.env.local for local dev). This root file remains the complete
# inventory enforced by scripts/check-env-docs.sh.
# API origin baked into the web image's /api/* rewrites (Dockerfile ARG).
API_INTERNAL_URL=http://localhost:4000/api/:path*
# Public API base consumed by the browser. Prefer NEXT_PUBLIC_API_BASE_URL;
# NEXT_PUBLIC_API_URL is the deprecated fallback (still honoured).
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_URL=/api/v1
# IANA timezone for displayed dates/times (default Europe/London).
NEXT_PUBLIC_TIMEZONE=Europe/London
# Locale for date/number formatting (default en-GB).
NEXT_PUBLIC_LOCALE=en-GB
# ISO 4217 currency for money formatting (default GBP).
NEXT_PUBLIC_CURRENCY=GBP
# Geofence for attendance check-in: site centre + radius in metres.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_LATITUDE=
NEXT_PUBLIC_SITE_LONGITUDE=
NEXT_PUBLIC_SITE_RADIUS_METERS=200
# VAPID public key for Web Push subscriptions (profile → notifications).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Mirrors the API's ALLOW_PUBLIC_REGISTRATION for the web build (default false
# = invitation-only; hides the /register page). next.config.mjs also maps the
# API-named ALLOW_PUBLIC_REGISTRATION into this var, so one knob can serve
# the whole deployment. The API 403s /auth/register regardless.
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=false
# Contract-test helper for `pnpm gen:api-types` (apps/web/package.json) —
# overrides the swagger JSON location. Build-time only, not read at runtime.
API_DOCS_JSON_URL=http://localhost:4000/api/docs-json

# ------------------------------------------------------------------------------
# Email — SMTP_HOST REQUIRED in production (invitation, verification and
# password-reset delivery are security-critical; fail closed, no silent drop).
# When SMTP_HOST is unset the dev log fallback is used (dev only).
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Envelope From. EMAIL_FROM is honoured as a legacy alias.
SMTP_FROM=no-reply@example.com
EMAIL_FROM=
# Socket/connect timeout for the worker SMTP client (ms).
SMTP_TIMEOUT_MS=15000
# Dev fallback: log rendered emails instead of sending.
EMAIL_DEV_LOG_FALLBACK=true

# ------------------------------------------------------------------------------
# OAuth sign-in (Google / Microsoft). OAUTH_ENABLED=false (default) disables
# the OAuth path entirely. When enabled, each configured provider needs its
# client ID + secret + redirect URI; MICROSOFT_TENANT defaults to 'common'.
# Account linking requires IdP-verified email; MFA-enrolled users must still
# complete the MFA challenge on the OAuth path.
# ------------------------------------------------------------------------------
OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=common

# ------------------------------------------------------------------------------
# MFA (TOTP)
# ------------------------------------------------------------------------------
MFA_ISSUER=NEO EMS
# Allowed TOTP clock-skew steps on either side (otplib `window`).
MFA_TOTP_WINDOW=1

# ------------------------------------------------------------------------------
# Production compose topology knobs
# ------------------------------------------------------------------------------
# Directory holding tls.crt + tls.key mounted into the prod nginx
# (docker-compose.prod.yml). Provide real certs here (certbot, internal CA).
TLS_CERT_DIR=./certs

# ------------------------------------------------------------------------------
# Seeding / ops scripts
# ------------------------------------------------------------------------------
# Seed refuses to run unless NODE_ENV=development or ALLOW_SEED=yes.
ALLOW_SEED=
# scripts/backup-db.sh destination.
BACKUP_DIR=./backups
# scripts/create-first-admin.ts — bootstrap the first SUPER_ADMIN.
# Never commit real values; pass inline, e.g.:
#   ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD='<12+ chars>' \
#     pnpm --filter @ems/api ts-node scripts/create-first-admin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# ------------------------------------------------------------------------------
# Local testing only (not read by production code paths)
# ------------------------------------------------------------------------------
# Separate database for the API e2e suite (apps/api/test).
E2E_DATABASE_URL=
