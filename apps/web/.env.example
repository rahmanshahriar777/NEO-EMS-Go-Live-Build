# NEO EMS — web frontend environment (copy to .env.local; never commit secrets)
#
# API connection -----------------------------------------------------------
# Base URL of the API, including the version prefix.
# Set to "/api/v1" to use the same-origin Next.js rewrite (/api/* -> API server).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Legacy fallback honourable by lib/env.ts (deprecated, prefer the above):
# NEXT_PUBLIC_API_URL=

# Public registration ------------------------------------------------------
# Mirrors the API's ALLOW_PUBLIC_REGISTRATION flag. When "false" (default),
# the web /register page renders an invitation-only notice instead of the
# sign-up form (the API already 403s the endpoint). next.config.mjs also maps
# the API-named ALLOW_PUBLIC_REGISTRATION into this NEXT_PUBLIC_ var so a
# single deployment knob works for both apps.
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=false

# Push notifications -------------------------------------------------------
# VAPID public key for web-push. Published by the API, not a secret — but the
# web client prefers the runtime value from GET /notifications/vapid-public-key
# and only falls back to this build-time value.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Display defaults ---------------------------------------------------------
NEXT_PUBLIC_TIMEZONE=Europe/London
NEXT_PUBLIC_LOCALE=en-GB
NEXT_PUBLIC_CURRENCY=GBP

# Site geofence (location-checked clock-in) ---------------------------------
# Coordinates of the site the client gates clock-ins against (UX only — the
# API re-validates server-side). Empty/unset disables the client gate with an
# explanatory message. Baked at build time like all NEXT_PUBLIC_* vars.
# NEXT_PUBLIC_SITE_NAME=
# NEXT_PUBLIC_SITE_LATITUDE=
# NEXT_PUBLIC_SITE_LONGITUDE=
# NEXT_PUBLIC_SITE_RADIUS_METERS=200

# Contract-test helper ------------------------------------------------------
# Override the swagger JSON location used by `pnpm gen:api-types`.
# API_DOCS_JSON_URL=http://localhost:4000/api/docs-json
